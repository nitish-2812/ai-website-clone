# ═══════════════════════════════════════════════════════
# AI Website Cloner — Environment Configuration
# ═══════════════════════════════════════════════════════

# LLM Provider: "gemini" (free), "openai", or "anthropic"
LLM_PROVIDER=gemini

# Gemini API Key (FREE — get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Models (defaults work great for free tier)
LLM_MODEL=gemini-2.0-flash
VISION_MODEL=gemini-2.0-flash

# Optional: OpenAI / Anthropic keys (if using those providers instead)
# OPENAI_API_KEY=sk-your-openai-api-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Pipeline Settings
MAX_RETRIES=3
OUTPUT_DIR=./output
VERBOSE=false
